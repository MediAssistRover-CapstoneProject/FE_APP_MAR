# true: chạy dữ liệu mô phỏng. false: kết nối API đã triển khai.
EXPO_PUBLIC_USE_MOCK=true
# Trên iPhone, dùng địa chỉ LAN của máy chạy backend hoặc HTTPS.
# localhost trên điện thoại trỏ đến chính điện thoại.
EXPO_PUBLIC_ROBOT_API_URL=http://192.168.1.10:8080/api
EXPO_PUBLIC_ROBOT_ID=MAR-01
# Không đặt mật khẩu, API secret hoặc access token trong EXPO_PUBLIC_*.
